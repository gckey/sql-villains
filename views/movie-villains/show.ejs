<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= movieVillain.name %> - Movie Villains
  </title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <main class="container">
    <header class="page-header">
      <div class="page-title-group">
        <a href="/movie-villains" class="link" style="margin-bottom: var(--space-2)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" str oke-width="2"
            stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7" />
          </svg>
          Back to All Villains
        </a>
        <h1>
          <%= movieVillain.name %>
        </h1>
      </div>
      <div class="page-actions">
        <a href="/movie-villains/<%= movieVillain.id %>/edit" class="btn btn-secondary">Edit</a>
        <form action="/movie-villains/<%= movieVillain.id %>?_method=DELETE" method="POST" styl e="display: inline;">
          <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this villain?');">Delete</button>
        </form>
      </div>
    </header>

    <article class="card detail-card">
      <header class="detail-header">
        <div class="detail-id">
          <%= movieVillain.id %>
        </div>
        <div class="detail-title-group">
          <h2 class="detail-name">
            <%= movieVillain.name %>
          </h2>
          <div class="detail-movie">
            <%= movieVillain.movie %>
          </div>
        </div>
        <div class="detail-actions">
          <a href="/movie-villains/<%= movieVillain.id %>/edit" class="btn btn-secondary btn-sm
">Edit</a>
          <form action="/movie-villains/<%= movieVillain.id %>?_method=DELETE" method="POST" st yle="display: inline;">
            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this villain?');">Delete</button>
          </form>
        </div>
      </header>

      <div class="detail-meta">
        <div class="meta-item">
          <div class="meta-label">Name</div>
          <div class="meta-value">
            <%= movieVillain.name %>
          </div>
        </div>
        <div class="meta-item">
          <div class="meta-label">Movie</div>
          <div class="meta-value">
            <%= movieVillain.movie %>
          </div>
        </div>
        <div class="meta-item">
          <div class="meta-label">ID</div>
          <div class="meta-value">#<%= movieVillain.id %>
          </div>
        </div>
      </div>
    </article>

    <footer class="page-footer">
      <p>Movie Villains Collection — Built with Node.js, Express & PostgreSQL</p>
    </footer>
  </main>
</body>

</html>