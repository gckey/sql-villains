<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Show</title>
</head>
<body>
  <h1>Movie Villains Show</h1>
    <dl>
      <dt>ID</dt>    <dd><%= movieVillain.id %></dd>
      <dt>Name</dt>  <dd><%= movieVillain.name %></dd>
      <dt>Movie</dt> <dd><%= movieVillain.movie %></dd>
    </dl>
    <br>
  <a href="/movie-villains/<%= movieVillain.id %>/edit">Edit</a>
  <form action="/movie-villains/<%= movieVillain.id %>?_method=DELETE" method="POST" style="display: inline;">
    <button type="submit" onclick="return confirm('Are you sure you want to delete this villain?')">Delete
    </button>
  </form>
  <br><br>
  <a href="/movie-villains">Back to all villains</a>
</body>
</html>